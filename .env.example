FINWISE_ENV=development
BROKER_OAUTH_REDIRECT_URI=https://your-domain.example.com

# Notifications
TWILIO_SID=
TWILIO_AUTH=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TELEGRAM_BOT_TOKEN=
DEFAULT_PHONE_COUNTRY_CODE=+234
FINWISE_BYPASS_NOTIFICATION_PROXIES=
# Main public app/tunnel URL used for mobile redirect.
FINWISE_PUBLIC_MOBILE_BASE=
# Optional separate public URL for the chart API. Leave blank to reuse
# FINWISE_PUBLIC_MOBILE_BASE when the main host proxies /api/market/terminal.
FINWISE_PUBLIC_CHART_API_BASE=

# Copilot AI
OPENAI_API_KEY=
# Default local model runtime for Finwise Copilot
FINWISE_COPILOT_MODEL=llama3.1:8b
FINWISE_COPILOT_FALLBACK_MODEL=
FINWISE_COPILOT_PROVIDER=ollama
FINWISE_COPILOT_BASE_URL=http://127.0.0.1:11434
FINWISE_COPILOT_TIMEOUT_SECONDS=25
FINWISE_COPILOT_MAX_HISTORY=6
FINWISE_COPILOT_TEMPERATURE=0.18
FINWISE_COPILOT_MAX_TOKENS=520
FINWISE_COPILOT_OLLAMA_NUM_CTX=8192
# Finwise-owned Ollama-compatible runtime option:
# FINWISE_COPILOT_MODEL=finwise-scratch:0.1
# FINWISE_COPILOT_BASE_URL=http://127.0.0.1:11435
# FINWISE_LOCAL_MODEL_NAME=finwise-scratch:0.1

# Bybit
BYBIT_OAUTH_CLIENT_ID=
BYBIT_OAUTH_CLIENT_SECRET=  

# Coinbase App OAuth2
# Coinbase notes in the official docs that OAuth client creation is limited to approved partners.
COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_SECRET=

# Kraken Connect OAuth2
# Kraken confidential clients use a decrypted client secret.
KRAKEN_OAUTH_CLIENT_ID=
KRAKEN_OAUTH_CLIENT_SECRET=

# OKX OAuth Broker
# OKX publishes the broker program docs, but the exact OAuth URLs are typically provided after broker approval.
OKX_OAUTH_CLIENT_ID=
OKX_OAUTH_CLIENT_SECRET=
OKX_OAUTH_AUTHORIZE_URL=
OKX_OAUTH_TOKEN_URL=
OKX_API_BASE_URL=https://www.okx.com

# Deriv API for synthetic indices
# Create a token in Deriv, then paste it here or enter it in the Synthetic Trade page.
DERIV_APP_ID=1089
DERIV_API_TOKEN=
